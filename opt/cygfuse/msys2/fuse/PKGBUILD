pkgname=winfsp-fuse
pkgver=2.8
pkgrel=10
pkgdesc="WinFsp FUSE compatibility layer for MSYS2"
arch=("i686" "x86_64")
url="https://winfsp.dev"
license=("GPL-3.0-only")
depends=("msys2-runtime")
makedepends=("gcc" "make")
options=("!strip")

: "${WINFSP_SRC_URI:=https://github.com/winfsp/winfsp/archive/master.tar.gz}"
: "${WINFSP_SRC_DIR:=winfsp-master}"

source=("${WINFSP_SRC_URI}")
sha256sums=("SKIP")

build()
{
    cd "${srcdir}/${WINFSP_SRC_DIR}/opt/cygfuse/fuse"
    make
}

package()
{
    cd "${srcdir}/${WINFSP_SRC_DIR}"

    install -Dm755 "opt/cygfuse/fuse/build/${CARCH}/cygfuse-${pkgver}.dll" \
        "${pkgdir}/usr/bin/cygfuse-${pkgver}.dll"
    install -Dm644 "opt/cygfuse/fuse/build/${CARCH}/libfuse-${pkgver}.dll.a" \
        "${pkgdir}/usr/lib/libfuse-${pkgver}.dll.a"
    install -Dm644 "opt/cygfuse/fuse/build/${CARCH}/fuse.pc" \
        "${pkgdir}/usr/lib/pkgconfig/fuse.pc"

    ln -s "libfuse-${pkgver}.dll.a" "${pkgdir}/usr/lib/libfuse.dll.a"

    install -Dm644 inc/fuse/fuse.h "${pkgdir}/usr/include/fuse/fuse.h"
    install -Dm644 inc/fuse/fuse_common.h "${pkgdir}/usr/include/fuse/fuse_common.h"
    install -Dm644 inc/fuse/fuse_opt.h "${pkgdir}/usr/include/fuse/fuse_opt.h"
    install -Dm644 inc/fuse/winfsp_fuse.h "${pkgdir}/usr/include/fuse/winfsp_fuse.h"
}
